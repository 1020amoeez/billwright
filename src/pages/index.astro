---
import SiteLayout from '~/layouts/SiteLayout.astro';
import Hero from '~/components/home/Hero.astro';
import FactStrip from '~/components/home/FactStrip.astro';
import LiveDemo from '~/components/home/LiveDemo.astro';
import ToolsSection from '~/components/home/ToolsSection.astro';
import TemplateShowcase from '~/components/home/TemplateShowcase.astro';
import CountrySection from '~/components/home/CountrySection.astro';
import HowItWorks from '~/components/home/HowItWorks.astro';
import WhySection from '~/components/home/WhySection.astro';
import FinalCta from '~/components/home/FinalCta.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Billwright',
    url: 'https://billwright.pages.dev/',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    description:
      'Free invoice generator, quotation and receipt makers, and small-business calculators. Runs entirely in your browser, no account needed.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<SiteLayout
  title="Billwright — free invoice generator and small business tools"
  description="Make an invoice, quotation or receipt and download the PDF in under a minute. Free, no account, and everything runs in your browser."
  jsonLd={jsonLd}
>
  <Hero />
  <FactStrip />
  <LiveDemo />
  <ToolsSection />
  <TemplateShowcase />
  <CountrySection />
  <HowItWorks />
  <WhySection />
  <FinalCta />
</SiteLayout>

<script>
  import '~/scripts/home';
</script>
