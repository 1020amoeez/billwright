---
import AppLayout from '~/layouts/AppLayout.astro';
import GeneratorApp from '~/components/invoice/GeneratorApp.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Billwright receipt generator',
    url: 'https://billwright.pages.dev/receipt-generator',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<AppLayout
  title="Free receipt generator — proof of payment as a PDF"
  description="Make a receipt for cash or bank transfer in seconds and download it as a PDF. Free, no account needed."
  jsonLd={jsonLd}
>
  <GeneratorApp kind="receipt" />
</AppLayout>
