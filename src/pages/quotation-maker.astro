---
import AppLayout from '~/layouts/AppLayout.astro';
import GeneratorApp from '~/components/invoice/GeneratorApp.astro';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'Billwright quotation maker',
    url: new URL('/quotation-maker', Astro.site).href,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Any',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];
---

<AppLayout
  title="Free quotation maker — send an estimate, then invoice it"
  description="Make a quotation your client can say yes to, then turn it into an invoice when the job is won. Free and no account."
  jsonLd={jsonLd}
>
  <GeneratorApp kind="quotation" />
</AppLayout>
