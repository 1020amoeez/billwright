---
/** Sun/moon toggle. State lives on <html data-theme>, set before first paint. */
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-pressed="false">
  <span class="visually-hidden" data-theme-label>Switch to light theme</span>
  <svg class="theme-toggle__icon theme-toggle__icon--moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__icon--sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: relative;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--r-btn);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .theme-toggle:hover {
    color: var(--text);
    border-color: var(--border-strong);
    background: var(--panel);
  }

  .theme-toggle__icon {
    position: absolute;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  /* The icon shows the theme the button switches TO, matching its label. */
  .theme-toggle__icon--moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  .theme-toggle__icon--sun {
    opacity: 1;
    transform: none;
  }

  :global([data-theme='light']) .theme-toggle__icon--sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global([data-theme='light']) .theme-toggle__icon--moon {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 560px) {
    .theme-toggle { width: 44px; height: 44px; }
  }
</style>

<script>
  const KEY = 'billwright:theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  const label = button?.querySelector<HTMLElement>('[data-theme-label]');

  function sync() {
    const isLight = root.dataset.theme === 'light';
    button?.setAttribute('aria-pressed', String(isLight));
    if (label) label.textContent = isLight ? 'Switch to dark theme' : 'Switch to light theme';
  }

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';

    // Transitions are enabled only for the length of the switch.
    root.classList.add('theme-switching');
    root.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {
      /* Private mode: the theme just will not be remembered. */
    }
    sync();
    window.setTimeout(() => root.classList.remove('theme-switching'), 240);
  });

  // Follow the system until someone states a preference.
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
    try {
      if (localStorage.getItem(KEY)) return;
    } catch {
      /* fall through */
    }
    root.dataset.theme = event.matches ? 'light' : 'dark';
    sync();
  });

  sync();
</script>
