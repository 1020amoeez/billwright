---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const links = [
  { href: '/invoice-generator', label: 'Invoice generator' },
  { href: '/invoice-templates', label: 'Templates' },
  { href: '/calculators', label: 'Calculators' },
  { href: '/guides', label: 'Guides' },
];

const isActive = (href: string) =>
  path === href || (href === '/calculators' && path.endsWith('-calculator'));
---

<header class="site-header" id="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/">
      <Logo size={30} />
      Billwright
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['site-nav__link', { 'is-active': isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__end">
      <ThemeToggle />
      <a class="btn-accent site-header__cta" href="/invoice-generator">Make an invoice</a>

      <details class="menu">
        <summary aria-label="Menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </summary>
        <div class="menu__panel">
          {links.map((l) => <a href={l.href} class="menu__link">{l.label}</a>)}
          <a class="btn-accent menu__cta" href="/invoice-generator">Make an invoice</a>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  /* The rule only appears once the page has moved, so the hero starts clean. */
  .site-header:global(.is-stuck) {
    border-bottom-color: var(--hairline);
    box-shadow: var(--elev-1);
  }

  .site-header__inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .site-nav {
    display: flex;
    align-items: center;
    min-height: 44px;
    gap: 32px;
    font-size: var(--t-small);
    font-weight: 500;
  }

  .site-nav__link {
    position: relative;
    color: var(--text-muted);
    padding-block: 4px;
    transition: color var(--dur) var(--ease);
  }

  .site-nav__link:hover { color: var(--text); }

  /* Active state is an underline as well as a colour, never colour alone. */
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav__link.is-active {
    color: var(--text);
  }

  .site-nav__link.is-active::after { transform: scaleX(1); }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .site-header__cta {
    height: 40px;
    padding: 0 18px;
    font-size: var(--t-small);
  }

  .menu { display: none; position: relative; }

  .menu > summary {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: var(--r-btn);
    color: var(--text);
    cursor: pointer;
    list-style: none;
  }

  .menu > summary::-webkit-details-marker { display: none; }
  .menu[open] > summary { border-color: var(--accent); color: var(--accent-text); }

  .menu__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 12px);
    z-index: 40;
    min-width: 240px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--elev-2);
  }

  .menu__link {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--r-input);
    font-size: var(--t-body);
    font-weight: 500;
    color: var(--text-muted);
  }

  .menu__link:hover { background: var(--bg); color: var(--text); }

  .menu__cta { height: 44px; margin-top: 8px; }

  @media (max-width: 1040px) {
    .site-nav { display: none; }
    .menu { display: block; }
  }

  @media (max-width: 560px) {
    .site-header__cta { display: none; }
    .brand { font-size: 19px; }
  }
</style>

<script>
  // One passive listener toggling a class — no scroll-linked layout work.
  const header = document.querySelector('#site-header');
  if (header) {
    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
