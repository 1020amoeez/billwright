---
import AppHeader from '~/components/chrome/AppHeader.astro';
import Icon from '~/components/ui/Icon.astro';
import { taxOptions } from '~/data/countries';
import { defaultState } from '~/scripts/defaults';
import { computeTotals, type DocKind } from '~/scripts/store';
import { renderPaper, copyFor } from '~/scripts/paper';
import { renderItems } from '~/scripts/itemsView';

interface Props {
  kind: DocKind;
}
const { kind } = Astro.props;

const state = defaultState(kind);
const taxes = taxOptions();
const initialTax = taxes.find((t) => t.value === state.tax);
const totals = computeTotals(state, initialTax?.rate ?? 0);
const paperHtml = renderPaper(state, totals, {
  taxLabel: initialTax?.taxLabel ?? '',
  taxRate: initialTax?.rate ?? 0,
});
const copy = copyFor[kind];
const noun = copy.title.toLowerCase();
---

<div class="app" data-kind={kind}>
  <AppHeader currency={state.currency} template={state.template} downloadLabel="Download PDF" />

  {/* The design gives this screen no visible heading; it still needs one. */}
  <h1 class="visually-hidden">{copy.title} generator</h1>

  <div class="pane-tabs" role="tablist" aria-label="Editor view">
    <button type="button" role="tab" id="tab-form" aria-controls="pane-form" aria-selected="true" class="pane-tabs__tab is-active">Form</button>
    <button type="button" role="tab" id="tab-preview" aria-controls="pane-preview" aria-selected="false" class="pane-tabs__tab">Preview</button>
  </div>

  <div class="split" id="split" data-pane="form">
    <!-- Form -->
    <form class="form" id="pane-form" role="tabpanel" aria-labelledby="tab-form" novalidate>
      <section class="form__section">
        <h2>Design</h2>
        <!-- Colour names, fonts and template names apply instantly on this
             device; anything else is read by AI after a pause in typing. -->
        <div class="ai-box">
          <label class="field">
            <span class="ai-box__label">Describe the look</span>
            <input
              type="text"
              id="style-text"
              maxlength="300"
              autocomplete="off"
              placeholder="Make it navy with a serif font"
            />
          </label>
          <p class="ai-box__status" id="style-status" aria-live="polite"></p>
        </div>
        <div class="look-row">
          <label class="look-pick">
            <input type="color" data-look="accent" value={state.look.accent} />
            Accent
          </label>
          <label class="look-pick">
            <input type="color" data-look="heading" value={state.look.heading} />
            Headings
          </label>
          <label class="look-font">
            Font
            <select data-look="font">
              <option value="sans">Sans</option>
              <option value="serif">Serif</option>
              <option value="mono">Mono</option>
            </select>
          </label>
          <button type="button" class="btn-outline look-reset" data-action="reset-look">Reset</button>
        </div>

        <!-- The logo is read and stored in this browser; it is never uploaded. -->
        <div class="logo-box" id="logo-box">
          <div class="logo-box__thumb" id="logo-thumb" aria-hidden="true"></div>
          <div class="logo-box__main">
            <div class="logo-box__actions">
              <button type="button" class="btn-outline logo-box__btn" data-action="pick-logo" id="pick-logo">
                Upload logo
              </button>
              <button type="button" class="btn-outline logo-box__btn" data-action="match-logo" id="match-logo" hidden>
                Match colours
              </button>
              <button type="button" class="logo-box__link" data-action="remove-logo" id="remove-logo" hidden>
                Remove
              </button>
            </div>
            <div class="logo-box__options">
              <label class="look-font">
                Size
                <select data-brand="size">
                  <option value="small">Small</option>
                  <option value="medium">Medium</option>
                  <option value="large">Large</option>
                </select>
              </label>
              <label class="logo-box__check">
                <input type="checkbox" data-brand="show" checked />
                <span id="show-label">Show initials</span>
              </label>
              <label class="logo-box__check" id="watermark-option" hidden>
                <input type="checkbox" data-brand="watermark" />
                Watermark
              </label>
            </div>
            <p class="ai-box__status" id="logo-status" aria-live="polite">
              PNG, JPG or SVG, or drop it on the preview. It stays on this device.
            </p>
          </div>
          <input type="file" id="logo-file" accept="image/png,image/jpeg,image/svg+xml,image/webp" hidden />
        </div>
      </section>

      <section class="form__section">
        <h2>Your business</h2>
        <p class="form__legend"><span class="req" aria-hidden="true">*</span> Required to download</p>
        <div class="form__grid">
          <label class="field">
            <span>Business name <span class="req" aria-hidden="true">*</span></span>
            <input type="text" data-field="businessName" required aria-required="true" autocomplete="organization" value={state.businessName} />
          </label>
          <label class="field">
            Email
            <input type="email" data-field="businessEmail" autocomplete="email" placeholder="hello@yourbusiness.com" value={state.businessEmail} />
          </label>
        </div>
        <label class="field">
          <span>Address <span class="req" aria-hidden="true">*</span></span>
          <input type="text" data-field="businessAddress" required aria-required="true" autocomplete="street-address" placeholder="Street, city, postcode" value={state.businessAddress} />
        </label>
      </section>

      <section class="form__section">
        <h2>Bill to</h2>
        <div class="form__grid">
          <label class="field">
            <span>Client name <span class="req" aria-hidden="true">*</span></span>
            <input type="text" data-field="clientName" required aria-required="true" value={state.clientName} />
          </label>
          <label class="field">
            <span>{copy.dueLabel === 'Due' ? 'Due date' : copy.dueLabel} <span class="req" aria-hidden="true">*</span></span>
            <input type="date" data-field="dueDate" required aria-required="true" value={state.dueDate} />
          </label>
        </div>
        <div class="form__grid">
          <label class="field">
            <span>{copy.title} number <span class="req" aria-hidden="true">*</span></span>
            <input type="text" data-field="number" required aria-required="true" value={state.number} />
          </label>
          <label class="field">
            <span>Issue date <span class="req" aria-hidden="true">*</span></span>
            <input type="date" data-field="issueDate" required aria-required="true" value={state.issueDate} />
          </label>
        </div>
      </section>

      <section class="form__section">
        <div class="form__section-head">
          <h2>Items</h2>
          <button type="button" class="btn-outline form__add" data-action="add-item">Add item</button>
        </div>
        <!-- AI drafting. Runs after a pause in typing, and sends only this box. -->
        <div class="ai-box">
          <label class="field">
            <span class="ai-box__label">Describe the work, and the items fill in as you type</span>
            <textarea
              rows="3"
              id="draft-text"
              maxlength="600"
              placeholder="Built a 5-page WordPress site, 2 rounds of revisions, 40 hours at 3,500 an hour"
            ></textarea>
          </label>
          <p class="ai-box__status" id="draft-status" aria-live="polite"></p>
          <p class="ai-box__note">
            Sends only what you type in these AI boxes. Your client, business details and amounts
            stay on your device.
          </p>
        </div>

        <div class="items">
          <div class="items__head">
            <div>Item <span class="req" aria-hidden="true">*</span></div>
            <div>Qty</div>
            <div>Unit price</div>
            <div></div>
          </div>
          <div class="items__list" id="items-list" set:html={renderItems(state.items)} />
        </div>
      </section>

      <div class="form__grid">
        <label class="field">
          Tax
          <select data-field="tax">
            {taxes.map((t) => <option value={t.value} selected={t.value === state.tax}>{t.label}</option>)}
            <option value="custom">Other rate</option>
            <option value="none">None</option>
          </select>
        </label>
        <label class="field">
          Discount
          <input type="text" inputmode="decimal" data-field="discount" placeholder="0" value={state.discount} />
        </label>
      </div>

      <label class="field" id="custom-rate-field" hidden>
        <span>Tax rate (%) <span class="req" aria-hidden="true">*</span></span>
        <input type="text" inputmode="decimal" data-field="taxRate" aria-required="true" placeholder="e.g. 8.25" value={state.taxRate} />
      </label>

      <label class="field">
        Notes
        <textarea rows="2" data-field="notes">{state.notes}</textarea>
      </label>

      <div class="form__foot">
        <p class="form__trust">
          <Icon name="lock" size={16} stroke={2} />
          Saved in this browser only. Your invoice is never uploaded.
        </p>
        <button type="button" class="btn-outline form__reset" data-action="reset">Start a new {noun}</button>
      </div>
    </form>

    <!-- Preview -->
    <div class="preview" id="pane-preview" role="tabpanel" aria-labelledby="tab-preview">
      <div class="preview__bar">
        <span>Live preview</span>
        <span id="page-count">A4, 1 page</span>
      </div>
      <div class="paper-stage" id="paper-stage">
        <div class="paper-scaler" id="paper-scaler">
          <div class={`paper paper--${state.template}`} id="paper" set:html={paperHtml} />
        </div>
      </div>
    </div>
  </div>

  <p class="sr-status" role="status" aria-live="polite" id="status"></p>
</div>

<style>
  .app {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .split {
    flex-grow: 1;
    display: grid;
    grid-template-columns: 560px minmax(0, 1fr);
    min-height: 0;
  }

  /* Form */
  .form {
    padding: 32px var(--gutter-app) 40px;
    border-right: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 28px;
    overflow-y: auto;
    max-height: calc(100vh - var(--header-app-h));
  }

  .form__section {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .form h2 {
    font-weight: 600;
    font-size: 20px;
  }

  .form__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .form__section-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .form__add {
    height: 36px;
    padding: 0 14px;
    font-size: 14px;
  }

  .ai-box {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    background: var(--bg-raised);
  }

  .ai-box__label {
    font-weight: 500;
  }

  .ai-box textarea {
    height: auto;
    padding: 10px 12px;
    resize: vertical;
    line-height: 1.5;
  }

  .ai-box__status {
    min-height: 18px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .ai-box__status[data-state='busy'] { color: var(--accent-text); }
  .ai-box__status[data-state='error'] { color: var(--text); }

  .ai-box__note {
    font-size: 12px;
    line-height: 1.45;
    color: var(--text-faint);
  }

  .look-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 18px;
  }

  .look-pick {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
    cursor: pointer;
  }

  .look-pick input {
    width: 36px;
    height: 36px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-raised);
    cursor: pointer;
  }

  .look-font {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .look-font select {
    height: 36px;
    padding: 0 10px;
    border-radius: var(--r-input);
    border: 1px solid var(--border-strong);
    background-color: var(--panel);
    color: var(--text);
    font-size: 14px;
  }

  .logo-box {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--r-card);
    background: var(--bg-raised);
    transition: border-color 0.15s;
  }

  .logo-box.is-dropping,
  .preview.is-dropping {
    border-color: var(--accent);
    outline: 2px dashed var(--accent);
    outline-offset: -8px;
  }

  .logo-box__thumb {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #fff;
    border: 1px solid var(--border);
    overflow: hidden;
    font-weight: 700;
    font-size: 22px;
  }

  .logo-box__thumb img {
    max-width: 56px;
    max-height: 56px;
    object-fit: contain;
  }

  .logo-box__main {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    flex: 1;
  }

  .logo-box__actions,
  .logo-box__options {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }

  .logo-box__btn {
    height: 36px;
    padding: 0 14px;
    font-size: 14px;
  }

  .logo-box__link {
    min-height: 36px;
    padding: 0 4px;
    border: 0;
    background: none;
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: underline;
    cursor: pointer;
  }

  .logo-box__link:hover { color: var(--text); }

  .logo-box__check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
    cursor: pointer;
  }

  .logo-box__check input {
    width: 18px;
    height: 18px;
    accent-color: var(--accent);
  }

  .look-reset {
    height: 36px;
    padding: 0 14px;
    font-size: 14px;
    margin-left: auto;
  }

  /* Required marks and inline errors */
  .req {
    color: var(--danger);
    font-weight: 600;
  }

  .form__legend {
    margin-top: -6px;
    font-size: 12px;
    color: var(--text-faint);
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .items__head {
    display: grid;
    grid-template-columns: 1fr 72px 110px 36px;
    gap: 8px;
    padding: 0 2px;
    font-size: 12px;
    color: var(--text-muted);
  }

  .items__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .form__foot {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form__trust {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--text-muted);
  }

  .form__reset {
    align-self: flex-start;
    height: 40px;
    font-size: 14px;
  }

  /* Preview */
  .preview {
    padding: 40px 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    background: var(--bg-deep);
    overflow: hidden;
  }

  .preview__bar {
    width: 100%;
    display: flex;
    justify-content: space-between;
    font-size: 14px;
    color: var(--text-muted);
  }

  /* Tabs — below 900px only, no 1440 equivalent in the design */
  .pane-tabs {
    display: none;
    gap: 8px;
    padding: 12px var(--gutter-app);
    border-bottom: 1px solid var(--hairline);
  }

  .pane-tabs__tab {
    flex: 1;
    height: 44px;
    border-radius: var(--r-btn);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text-muted);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }

  .pane-tabs__tab.is-active {
    background: var(--panel);
    border-color: var(--accent-text);
    color: var(--text);
  }

  /* Toast, also the aria-live region. Empty until something happens. */
  .sr-status {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    z-index: 60;
    margin: 0;
    padding: 12px 18px;
    border-radius: var(--r-btn);
    background: var(--panel);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 14px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
  }

  .sr-status:empty {
    display: none;
  }

  @media (max-width: 1200px) {
    .split { grid-template-columns: 480px minmax(0, 1fr); }
    .preview { padding: 32px 32px; }
  }

  @media (max-width: 900px) {
    .pane-tabs { display: flex; }
    .split { grid-template-columns: 1fr; }
    .form {
      border-right: 0;
      max-height: none;
      overflow: visible;
      padding-top: 24px;
    }
    .preview { padding: 24px 16px 40px; }
    /* The design's 36/40px controls come up to the 44px touch target here. */
    .form__add,
    .form__reset { height: 44px; }
    .split[data-pane='form'] .preview { display: none; }
    .split[data-pane='preview'] .form { display: none; }
  }
</style>

<style is:global>
  /* Line-item rows are re-rendered at runtime, so these cannot be scoped. */
  .item-row {
    display: grid;
    grid-template-columns: 1fr 72px 110px 36px;
    gap: 8px;
    align-items: center;
  }

  .item-row input {
    height: 44px;
    padding: 0 12px;
    border-radius: var(--r-input);
    border: 1px solid var(--border-strong);
    background: var(--panel);
    color: var(--text);
    font-size: 15px;
    min-width: 0;
  }

  .item-row input:hover { border-color: #4A556E; }

  .item-row__num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .item-row button {
    width: 36px;
    height: 44px;
    border: 0;
    border-radius: var(--r-input);
    background: transparent;
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .item-row button:hover { color: var(--accent-text); }
</style>

<script>
  import { initGenerator } from '~/scripts/generator';
  initGenerator();
</script>
