---
/**
 * The hero sheet. Renders complete on the server — the loop in home.ts only
 * replays it, so it is correct with JavaScript off and before hydration.
 */
const rows = [
  { desc: 'Brand identity design', qty: '1', amount: '1,800.00' },
  { desc: 'Landing page build', qty: '1', amount: '2,400.00' },
  { desc: 'Hosting setup', qty: '2', amount: '300.00' },
];
---

<div class="hero-invoice" data-hero-invoice>
  <div class="hero-invoice__sheet">
    <div class="hi-top">
      <div>
        <div class="hi-word">Invoice</div>
        <div class="hi-meta">No. 0042 · Due 6 Oct 2026</div>
      </div>
      <div class="hi-mark"></div>
    </div>

    <div class="hi-parties">
      <div>
        <span class="hi-label">From</span>
        <span class="hi-strong">Meridian Studio</span>
        <span class="hi-dim">Lahore, Pakistan</span>
      </div>
      <div>
        <span class="hi-label">Bill to</span>
        <span class="hi-strong" data-hero-client>Northwind Traders<i class="hi-caret" aria-hidden="true"></i></span>
        <span class="hi-dim">Manchester, UK</span>
      </div>
    </div>

    <div class="hi-table">
      <div class="hi-row hi-row--head">
        <span>Description</span><span>Qty</span><span>Amount</span>
      </div>
      {
        rows.map((r, i) => (
          <div class="hi-row hi-row--item" data-hero-row style={`--i:${i}`}>
            <span>{r.desc}</span>
            <span class="tnum">{r.qty}</span>
            <span class="tnum">{r.amount}</span>
          </div>
        ))
      }
    </div>

    <div class="hi-totals">
      <div class="hi-total"><span>Subtotal</span><span class="tnum">4,500.00</span></div>
      <div class="hi-total"><span>Sales tax 17%</span><span class="tnum">765.00</span></div>
      <div class="hi-total hi-total--grand">
        <span>Total</span>
        <span class="tnum" data-hero-total data-value="5265">5,265.00</span>
      </div>
    </div>
  </div>

  <div class="hero-invoice__chip" data-hero-chip>
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m4 12 5 5L20 6"></path>
    </svg>
    PDF ready
  </div>
</div>

<style>
  .hero-invoice {
    position: relative;
    width: 100%;
    max-width: 470px;
  }

  .hero-invoice__sheet {
    padding: 36px 36px 32px;
    background: var(--paper);
    color: var(--paper-ink);
    border-radius: 8px;
    border: 1px solid var(--paper-border);
    box-shadow: var(--shadow-paper-hero);
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 13px;
    transform: rotate(-1.6deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-invoice__sheet {
      animation: hero-float 9s var(--ease) infinite;
    }
  }

  @keyframes hero-float {
    0%, 100% { transform: rotate(-1.6deg) translateY(0); }
    50% { transform: rotate(-1.6deg) translateY(-9px); }
  }

  .hi-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .hi-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    letter-spacing: var(--ls-snug);
    line-height: 1;
  }

  .hi-meta,
  .hi-dim,
  .hi-label {
    color: var(--paper-muted);
  }

  .hi-meta { margin-top: 5px; font-size: 12px; }

  .hi-mark {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--accent);
  }

  .hi-parties {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    line-height: 1.5;
  }

  .hi-parties > div {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .hi-label { font-size: 11px; }
  .hi-strong { font-weight: 600; position: relative; }

  /* Typing caret, shown only while the client name is being retyped. */
  .hi-caret {
    display: inline-block;
    width: 1.5px;
    height: 1em;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--paper-ink);
    opacity: 0;
  }

  [data-hero-invoice].is-typing .hi-caret {
    opacity: 1;
    animation: caret 900ms steps(1) infinite;
  }

  @keyframes caret {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .hi-table {
    display: flex;
    flex-direction: column;
    border-top: 1.5px solid var(--paper-ink);
  }

  .hi-row {
    display: grid;
    grid-template-columns: 1fr 44px 78px;
    gap: 10px;
    padding: 9px 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .hi-row > span:nth-child(2),
  .hi-row > span:nth-child(3) { text-align: right; }

  .hi-row--head {
    padding: 8px 0;
    color: var(--paper-muted);
    font-size: 11px;
  }

  /* Rows start visible; the replay class hides then staggers them back in. */
  @media (prefers-reduced-motion: no-preference) {
    [data-hero-invoice].is-replaying .hi-row--item {
      opacity: 0;
      transform: translateY(6px);
      animation: hi-row-in 460ms var(--ease-out) forwards;
      animation-delay: calc(var(--i) * 170ms + 120ms);
    }
  }

  @keyframes hi-row-in {
    to { opacity: 1; transform: none; }
  }

  .hi-totals {
    align-self: flex-end;
    width: 210px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .hi-total {
    display: flex;
    justify-content: space-between;
    color: var(--paper-muted);
    font-size: 12px;
  }

  .hi-total--grand {
    margin-top: 4px;
    padding-top: 9px;
    border-top: 1.5px solid var(--paper-ink);
    color: var(--paper-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
  }

  .hero-invoice__chip {
    position: absolute;
    left: -14px;
    bottom: 26px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 36px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--accent-ink);
    font-size: var(--t-caption);
    font-weight: 600;
    box-shadow: var(--elev-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-hero-invoice].is-replaying .hero-invoice__chip {
      opacity: 0;
      transform: translateY(8px) scale(0.94);
      animation: chip-in 440ms var(--ease-out) forwards;
      animation-delay: 960ms;
    }
  }

  @keyframes chip-in {
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 900px) {
    .hero-invoice { max-width: 420px; margin-inline: auto; }
    .hero-invoice__sheet { transform: rotate(-1deg); }
    @keyframes hero-float {
      0%, 100% { transform: rotate(-1deg) translateY(0); }
      50% { transform: rotate(-1deg) translateY(-7px); }
    }
  }

  @media (max-width: 520px) {
    .hero-invoice__sheet { padding: 24px 20px 22px; gap: 18px; transform: none; }
    .hi-word { font-size: 25px; }
    .hi-totals { width: 100%; }
    .hero-invoice__chip { left: 8px; bottom: -14px; }
    @keyframes hero-float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }
  }
</style>
