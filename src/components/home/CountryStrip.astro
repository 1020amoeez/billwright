---
import { countries } from '~/data/countries';
---

<section class="countries shell">
  <div class="countries__box">
    <div class="countries__copy">
      <h2>Built for where you actually do business.</h2>
      <p>
        Pick your country and the invoice picks up the right tax line, currency format and required
        fields. GST, VAT or sales tax, without you looking it up.
      </p>
    </div>
    <ul class="countries__pills">
      {countries.map((c) => <li class="pill">{c.name}</li>)}
      <li class="pill pill--muted">and more</li>
    </ul>
  </div>
</section>

<style>
  .countries__box {
    padding: 56px 64px;
    border-radius: var(--r-section-lg);
    background: var(--panel);
    border: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: center;
  }

  .countries__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    font-weight: 700;
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  p {
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-muted);
  }

  .countries__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: var(--r-pill);
    border: 1px solid var(--border-strong);
    font-size: 15px;
  }

  .pill--muted { color: var(--text-muted); }

  @media (max-width: 1000px) {
    .countries__box {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 40px;
    }
    h2 { font-size: 30px; }
  }

  @media (max-width: 520px) {
    .countries__box { padding: 28px 22px; }
    h2 { font-size: 26px; }
  }
</style>
