---
import { countries, currencyCodes } from '~/data/countries';

const taxable = countries.filter((c) => c.taxRate !== null);

const seedRows = [
  { desc: 'Brand identity design', qty: '1', price: '1,800.00' },
  { desc: 'Landing page build', qty: '1', price: '2,400.00' },
  { desc: 'Hosting setup', qty: '2', price: '150.00' },
];
---

<section class="demo" id="demo">
  <div class="shell">
    <header class="demo__head" data-reveal>
      <h2>See your invoice come together.</h2>
      <p>
        Change anything on the left. This is the same maths and the same country rules the real
        generator uses — it just has fewer fields.
      </p>
    </header>

    <div class="demo__frame" data-demo data-reveal>
      <div class="demo__controls">
        <label class="demo__field">
          <span>Client</span>
          <input type="text" value="Northwind Traders" data-demo-input="client" maxlength="40" />
        </label>

        <div class="demo__rows">
          <div class="demo__rows-head">
            <span>Description</span><span>Qty</span><span>Unit price</span>
          </div>
          {
            seedRows.map((r, i) => (
              <div class="demo__row" data-demo-row hidden={i === 2}>
                <input type="text" value={r.desc} data-demo-input="desc" aria-label={`Item ${i + 1} description`} maxlength="34" />
                <input type="text" inputmode="decimal" value={r.qty} data-demo-input="qty" aria-label={`Item ${i + 1} quantity`} />
                <input type="text" inputmode="decimal" value={r.price} data-demo-input="price" aria-label={`Item ${i + 1} unit price`} />
              </div>
            ))
          }
          <button type="button" class="demo__add" data-demo-add>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <path d="M12 5v14M5 12h14"></path>
            </svg>
            Add a line
          </button>
        </div>

        <div class="demo__pair">
          <label class="demo__field">
            <span>Currency</span>
            <select data-demo-input="currency">
              {currencyCodes.map((c) => <option value={c} selected={c === 'PKR'}>{c}</option>)}
            </select>
          </label>
          <label class="demo__field">
            <span>Tax</span>
            <select data-demo-input="tax">
              {taxable.map((c) => (
                <option value={c.code} selected={c.code === 'pk'}>
                  {c.taxLabel} {c.taxRate}% ({c.shortName})
                </option>
              ))}
              <option value="none">None</option>
            </select>
          </label>
        </div>

        <a class="demo__cta" href="/invoice-generator">
          Open the full generator
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="demo__stage">
        <div class="demo__sheet">
          <div class="ds-top">
            <div>
              <div class="ds-word">Invoice</div>
              <div class="ds-dim">No. 0042</div>
            </div>
            <div class="ds-mark"></div>
          </div>

          <div class="ds-billto">
            <span class="ds-dim">Bill to</span>
            <span class="ds-strong" data-demo-out="client">Northwind Traders</span>
          </div>

          <div class="ds-table">
            <div class="ds-row ds-row--head"><span>Description</span><span>Qty</span><span>Amount</span></div>
            {
              seedRows.map((_, i) => (
                <div class="ds-row" data-demo-prow hidden={i === 2}>
                  <span data-demo-out="desc" />
                  <span class="tnum" data-demo-out="qty" />
                  <span class="tnum" data-demo-out="amount" />
                </div>
              ))
            }
          </div>

          <div class="ds-totals">
            <div class="ds-total"><span>Subtotal</span><span class="tnum" data-demo-out="subtotal"></span></div>
            <div class="ds-total" data-demo-taxrow>
              <span data-demo-out="taxLabel"></span><span class="tnum" data-demo-out="tax"></span>
            </div>
            <div class="ds-total ds-total--grand">
              <span>Total</span><span class="tnum" data-demo-out="total"></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .demo { padding-block: var(--section-y); }

  .demo__head {
    max-width: 620px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
  }

  h2 {
    font-weight: 700;
    font-size: var(--t-h2);
    line-height: 1.06;
    letter-spacing: var(--ls-snug);
  }

  .demo__head p {
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .demo__frame {
    display: grid;
    grid-template-columns: minmax(0, 420px) minmax(0, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--r-section-lg);
    background: var(--panel);
    overflow: hidden;
  }

  .demo__controls {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    border-right: 1px solid var(--border);
  }

  .demo__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--t-caption);
    color: var(--text-muted);
  }

  .demo__field input,
  .demo__field select,
  .demo__row input {
    height: 42px;
    padding: 0 11px;
    border-radius: var(--r-input);
    border: 1px solid var(--border-strong);
    background: var(--bg-raised);
    color: var(--text);
    font-size: var(--t-small);
    min-width: 0;
    transition: border-color var(--dur) var(--ease);
  }

  .demo__field input:hover,
  .demo__field select:hover,
  .demo__row input:hover { border-color: var(--accent-line); }

  .demo__rows { display: flex; flex-direction: column; gap: 8px; }

  .demo__rows-head,
  .demo__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 54px 88px;
    gap: 8px;
  }

  .demo__rows-head {
    font-size: 11px;
    color: var(--text-muted);
    padding-inline: 2px;
  }

  .demo__row input:nth-child(2),
  .demo__row input:nth-child(3) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .demo__add {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 13px;
    margin-top: 2px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-input);
    background: transparent;
    color: var(--text-muted);
    font-size: var(--t-caption);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .demo__add:hover { color: var(--accent-text); border-color: var(--accent); }
  .demo__add[hidden] { display: none; }

  .demo__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

  .demo__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--accent-text);
  }

  .demo__cta svg { transition: transform var(--dur) var(--ease-out); }
  .demo__cta:hover svg { transform: translateX(3px); }

  /* Preview */
  .demo__stage {
    padding: 40px;
    background: var(--bg-deep);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .demo__sheet {
    width: 100%;
    max-width: 420px;
    padding: 30px;
    background: var(--paper);
    color: var(--paper-ink);
    border: 1px solid var(--paper-border);
    border-radius: 6px;
    box-shadow: var(--shadow-paper);
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 12.5px;
  }

  .ds-top { display: flex; justify-content: space-between; align-items: flex-start; }

  .ds-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: var(--ls-snug);
    line-height: 1;
  }

  .ds-dim { color: var(--paper-muted); }
  .ds-top .ds-dim { margin-top: 4px; font-size: 11px; }

  .ds-mark { width: 34px; height: 34px; border-radius: 7px; background: var(--accent); }

  .ds-billto { display: flex; flex-direction: column; gap: 1px; }
  .ds-billto .ds-dim { font-size: 11px; }
  .ds-strong { font-weight: 600; }

  .ds-table { display: flex; flex-direction: column; border-top: 1.5px solid var(--paper-ink); }

  .ds-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 40px 76px;
    gap: 10px;
    padding: 8px 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .ds-row[hidden] { display: none; }

  .ds-row > span:nth-child(2),
  .ds-row > span:nth-child(3) { text-align: right; }

  .ds-row > span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ds-row--head { color: var(--paper-muted); font-size: 11px; padding: 7px 0; }

  .ds-totals {
    align-self: flex-end;
    width: 190px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .ds-total {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--paper-muted);
    font-size: 11.5px;
  }

  .ds-total[hidden] { display: none; }

  .ds-total--grand {
    margin-top: 3px;
    padding-top: 8px;
    border-top: 1.5px solid var(--paper-ink);
    color: var(--paper-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
  }

  /* A value that just changed gets a brief tint, never a size change. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.is-flash) { animation: flash 560ms var(--ease); }
  }

  @keyframes flash {
    0% { background-color: var(--accent-soft); }
    100% { background-color: transparent; }
  }

  @media (max-width: 980px) {
    .demo__frame { grid-template-columns: 1fr; }
    .demo__controls { border-right: 0; border-bottom: 1px solid var(--border); }
    .demo__stage { padding: 32px 20px; }
    .demo__cta { margin-top: 4px; }
  }

  @media (max-width: 520px) {
    .demo__controls { padding: 20px; }
    .demo__sheet { padding: 22px 18px; }
    .demo__rows-head, .demo__row { grid-template-columns: minmax(0, 1fr) 48px 74px; }
    .demo__pair { grid-template-columns: 1fr; }
  }
</style>
