---
import HeroPaper from './HeroPaper.astro';
import Icon from '~/components/ui/Icon.astro';
---

<section class="hero shell">
  <div class="hero__copy">
    <h1>Send a proper invoice in under a minute.</h1>
    <p class="hero__sub">
      Fill in the details, watch the PDF build itself, download it. No account, no watermark, no
      email required.
    </p>
    <div class="hero__actions">
      <a class="btn-accent hero__btn" href="/invoice-generator">Make an invoice</a>
      <a class="btn-outline hero__btn" href="/invoice-templates">Browse templates</a>
    </div>
    <p class="hero__trust">
      <Icon name="lock" size={18} stroke={2} />
      Everything runs in your browser. Your numbers never leave your device.
    </p>
  </div>

  <div class="hero__paper">
    <HeroPaper />
  </div>
</section>

<style>
  .hero {
    padding-block: 112px 96px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 80px;
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  h1 {
    font-weight: 700;
    font-size: 72px;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero__sub {
    font-size: 20px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 520px;
  }

  .hero__actions {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero__btn {
    height: 54px;
    padding: 0 26px;
    border-radius: var(--r-btn-lg);
    font-size: 17px;
  }

  .hero__trust {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    color: var(--text-muted);
  }

  .hero__trust :global(svg) {
    flex-shrink: 0;
  }

  .hero__paper {
    display: flex;
    justify-content: flex-end;
    padding-right: 24px;
  }

  @media (max-width: 1200px) {
    h1 { font-size: 60px; }
    .hero { gap: 48px; }
    .hero__paper { padding-right: 0; }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding-block: 64px 72px;
      gap: 56px;
    }
    h1 { font-size: 48px; }
    .hero__sub { font-size: 18px; }
    .hero__paper { justify-content: center; }
  }

  @media (max-width: 520px) {
    h1 { font-size: 38px; letter-spacing: -0.02em; }
    .hero__btn { width: 100%; }
  }
</style>
