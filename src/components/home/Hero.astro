---
import HeroInvoice from './HeroInvoice.astro';
import Icon from '~/components/ui/Icon.astro';
---

<section class="hero">
  <div class="hero__inner shell">
    <div class="hero__copy">
      <h1>Send a proper invoice in under a minute.</h1>
      <p class="hero__lead">
        Fill in the details, watch the PDF build itself, download it. No account, no watermark, no
        email required.
      </p>

      <div class="hero__actions">
        <a class="btn-accent hero__btn" href="/invoice-generator">
          Make an invoice
          <svg class="hero__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13M12 5l7 7-7 7"></path>
          </svg>
        </a>
        <a class="btn-outline hero__btn" href="/invoice-templates">Explore templates</a>
      </div>

      <p class="hero__trust">
        <Icon name="lock" size={17} stroke={2} />
        Everything runs in your browser. Your numbers never leave your device.
      </p>
    </div>

    <div class="hero__visual">
      <HeroInvoice />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
  }

  /* A single faint grid, not a floating shape — it gives the section structure. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, #000 30%, transparent 75%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    padding-block: 88px 84px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 72px;
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  h1 {
    font-weight: 700;
    font-size: var(--t-display);
    line-height: var(--lh-tight);
    letter-spacing: var(--ls-tight);
    max-width: 14ch;
  }

  .hero__lead {
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 48ch;
  }

  .hero__actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero__btn {
    height: 52px;
    padding: 0 24px;
    border-radius: var(--r-btn-lg);
    font-size: 16px;
  }

  .hero__arrow {
    transition: transform var(--dur) var(--ease-out);
  }

  .hero__btn:hover .hero__arrow { transform: translateX(3px); }

  .hero__trust {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: var(--t-small);
    color: var(--text-muted);
  }

  .hero__trust :global(svg) { flex-shrink: 0; }

  .hero__visual {
    display: flex;
    justify-content: flex-end;
  }

  @media (max-width: 1100px) {
    .hero__inner { gap: 40px; }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      padding-block: 56px 64px;
      gap: 52px;
    }
    h1 { max-width: 18ch; }
    .hero__visual { justify-content: center; }
    .hero::before { background-size: 56px 56px; }
  }

  @media (max-width: 520px) {
    .hero__btn { width: 100%; }
    .hero__inner { padding-bottom: 76px; }
  }
</style>
