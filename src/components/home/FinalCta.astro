---
---

<section class="cta">
  <div class="shell">
    <div class="cta__box" data-reveal>
      <div class="cta__copy">
        <h2>Create your next invoice in under a minute.</h2>
        <p>No account. No watermark. No unnecessary setup.</p>
      </div>
      <a class="cta__btn" href="/invoice-generator">
        Make an invoice
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h13M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: 0 var(--section-y); }

  .cta__box {
    position: relative;
    padding: 56px;
    border-radius: var(--r-section-lg);
    background: var(--accent);
    color: var(--accent-ink);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    overflow: hidden;
  }

  /* Same hairline grid as the hero, tying the top and bottom of the page. */
  .cta__box::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(16, 21, 34, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(16, 21, 34, 0.07) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 100% at 100% 50%, #000 10%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse 70% 100% at 100% 50%, #000 10%, transparent 70%);
    pointer-events: none;
  }

  .cta__copy { position: relative; display: flex; flex-direction: column; gap: 12px; }

  h2 {
    font-weight: 700;
    font-size: var(--t-h2);
    line-height: 1.06;
    letter-spacing: var(--ls-snug);
    max-width: 18ch;
  }

  .cta__copy p {
    font-size: var(--t-lead);
    opacity: 0.78;
  }

  .cta__btn {
    position: relative;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 56px;
    padding: 0 28px;
    border-radius: var(--r-btn-lg);
    background: var(--accent-ink);
    color: #F3F5F9;
    font-size: 16px;
    font-weight: 600;
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease);
  }

  .cta__btn:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(16, 21, 34, 0.28);
  }

  .cta__btn:active { transform: translateY(0); }

  .cta__btn svg { transition: transform var(--dur) var(--ease-out); }
  .cta__btn:hover svg { transform: translateX(3px); }

  @media (prefers-reduced-motion: reduce) {
    .cta__btn:hover { transform: none; }
  }

  @media (max-width: 860px) {
    .cta__box { flex-direction: column; align-items: flex-start; padding: 40px 28px; gap: 28px; }
    h2 { max-width: 20ch; }
    .cta__btn { width: 100%; justify-content: center; }
  }
</style>
