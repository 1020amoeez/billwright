---
/** Decorative invoice sheet in the hero. Static by design — the real,
 *  data-driven sheet lives in components/invoice/. */
const rows = [
  { desc: 'Brand identity design', qty: '1', amount: '1,800.00' },
  { desc: 'Landing page build', qty: '1', amount: '2,400.00' },
  { desc: 'Hosting setup', qty: '2', amount: '300.00' },
];
---

<div class="paper" aria-hidden="true">
  <div class="paper__top">
    <div class="paper__title">
      <div class="paper__word">Invoice</div>
      <div class="paper__no">No. 0042</div>
    </div>
    <div class="paper__mark"></div>
  </div>

  <div class="paper__parties">
    <div>
      <div class="muted">From</div>
      <div class="strong">[Your business]</div>
      <div class="muted">[Your address]</div>
    </div>
    <div>
      <div class="muted">Bill to</div>
      <div class="strong">[Client name]</div>
      <div class="muted">Due 12 Oct 2026</div>
    </div>
  </div>

  <div class="paper__table">
    <div class="paper__row paper__row--head">
      <div>Description</div><div>Qty</div><div>Amount</div>
    </div>
    {
      rows.map((r) => (
        <div class="paper__row">
          <div>{r.desc}</div>
          <div class="tnum">{r.qty}</div>
          <div class="tnum">{r.amount}</div>
        </div>
      ))
    }
  </div>

  <div class="paper__totals">
    <div class="paper__total-row muted"><span>Subtotal</span><span class="tnum">4,500.00</span></div>
    <div class="paper__total-row muted"><span>Sales tax 17%</span><span class="tnum">765.00</span></div>
    <div class="paper__total-row paper__total-row--grand"><span>Total</span><span class="tnum">5,265.00</span></div>
  </div>

  <div class="paper__note">Payment due within 14 days. Thank you.</div>
</div>

<style>
  .paper {
    width: 480px;
    height: 620px;
    padding: 44px 44px 40px;
    background: var(--paper);
    color: var(--paper-ink);
    border-radius: 6px;
    transform: rotate(-2deg);
    box-shadow: var(--shadow-paper-hero);
    display: flex;
    flex-direction: column;
    gap: 28px;
    font-size: 13px;
  }

  .paper__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }

  .paper__title {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .paper__word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 34px;
    letter-spacing: -0.02em;
  }

  .paper__no,
  .muted {
    color: var(--paper-muted);
  }

  .strong { font-weight: 600; }

  .paper__mark {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    background: var(--accent);
  }

  .paper__parties {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    line-height: 1.5;
  }

  .paper__parties > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .paper__table {
    display: flex;
    flex-direction: column;
    border-top: 2px solid var(--paper-ink);
  }

  .paper__row {
    display: grid;
    grid-template-columns: 1fr 72px 96px;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--paper-line);
  }

  .paper__row > div:nth-child(2),
  .paper__row > div:nth-child(3) {
    text-align: right;
  }

  .paper__row--head {
    padding: 10px 0;
    color: var(--paper-muted);
  }

  .paper__totals {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-self: flex-end;
    width: 240px;
  }

  .paper__total-row {
    display: flex;
    justify-content: space-between;
    color: var(--paper-muted);
  }

  .paper__total-row--grand {
    padding-top: 10px;
    border-top: 2px solid var(--paper-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--paper-ink);
  }

  .paper__note {
    margin-top: auto;
    font-size: 12px;
    color: var(--paper-muted);
  }

  @media (max-width: 900px) {
    .paper {
      width: 100%;
      max-width: 480px;
      height: auto;
      transform: rotate(-1.5deg);
    }
  }

  @media (max-width: 520px) {
    .paper {
      padding: 28px 24px 24px;
      gap: 20px;
      transform: none;
    }
    .paper__word { font-size: 28px; }
    .paper__totals { width: 100%; }
  }
</style>
