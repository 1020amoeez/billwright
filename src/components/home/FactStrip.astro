---
import { countries } from '~/data/countries';
import { templates } from '~/data/templates';
import { tools } from '~/data/tools';

/**
 * Product facts, not social proof. Every number here is counted from the data
 * the site actually ships, so nothing can drift or be invented.
 */
const facts = [
  { value: 'Under a minute', label: 'From blank form to downloaded PDF' },
  { value: 'No account', label: 'Nothing to sign up for, ever' },
  { value: String(countries.length), label: 'Countries with their own tax line' },
  { value: String(templates.length), label: 'Invoice templates, all free' },
  { value: String(tools.length), label: 'Tools for billing and pricing' },
  { value: 'Local-first', label: 'Your data stays in the browser' },
];
---

<section class="facts" aria-label="What Billwright gives you">
  <div class="facts__inner shell">
    {
      facts.map((f, i) => (
        <div class="fact" data-reveal style={`--reveal-delay:${i * 45}ms`}>
          <div class="fact__value">{f.value}</div>
          <div class="fact__label">{f.label}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .facts {
    border-block: 1px solid var(--hairline);
    background: var(--bg-raised);
  }

  .facts__inner {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .fact {
    padding: 26px 22px 26px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-right: 1px solid var(--hairline);
  }

  .fact:not(:first-child) { padding-left: 22px; }
  .fact:last-child { border-right: 0; padding-right: 0; }

  .fact__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 21px;
    letter-spacing: -0.015em;
    line-height: 1.1;
  }

  .fact__label {
    font-size: var(--t-caption);
    line-height: 1.45;
    color: var(--text-muted);
  }

  @media (max-width: 1100px) {
    .facts__inner { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .fact:nth-child(3n) { border-right: 0; }
    .fact:nth-child(-n + 3) { border-bottom: 1px solid var(--hairline); }
    .fact { padding-inline: 22px; }
    .fact:nth-child(3n + 1) { padding-left: 0; }
  }

  @media (max-width: 640px) {
    .facts__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fact { padding: 20px 16px; border-bottom: 1px solid var(--hairline); }
    .fact:nth-child(2n) { border-right: 0; }
    .fact:nth-child(2n + 1) { padding-left: 0; }
    .fact:nth-last-child(-n + 2) { border-bottom: 0; }
    .fact__value { font-size: 18px; }
  }
</style>
