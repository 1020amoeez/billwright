---
export interface CalcField {
  name: string;
  label: string;
  value?: string;
  placeholder?: string;
  /** Renders a select instead of a number box. */
  options?: { value: string; label: string }[];
}

interface Props {
  /** Key into the calculator registry. */
  calc: string;
  fields: CalcField[];
  primaryLabel: string;
  statLabels: string[];
}

const { calc, fields, primaryLabel, statLabels } = Astro.props;
---

<section class="calc" data-calc={calc} aria-label="Calculator">
  <div class="calc__inputs">
    {
      fields.map((f) =>
        f.options ? (
          <label class="calc__field">
            {f.label}
            <select data-input={f.name}>
              {f.options.map((o) => (
                <option value={o.value} selected={o.value === f.value}>
                  {o.label}
                </option>
              ))}
            </select>
          </label>
        ) : (
          <label class="calc__field">
            {f.label}
            <input
              type="text"
              inputmode="decimal"
              data-input={f.name}
              value={f.value ?? ''}
              placeholder={f.placeholder ?? '0'}
            />
          </label>
        ),
      )
    }
    <button type="button" class="calc__reset" data-action="calc-reset">Reset</button>
  </div>

  <div class="calc__results">
    <div class="calc__primary">
      <div class="calc__primary-label">{primaryLabel}</div>
      <div class="calc__primary-value tnum" data-out="primary">—</div>
    </div>

    <div class="calc__stats">
      {
        statLabels.map((label, i) => (
          <div class="calc__stat">
            <div class="calc__stat-label">{label}</div>
            <div class="calc__stat-value tnum" data-out={`stat${i}`}>
              —
            </div>
          </div>
        ))
      }
    </div>

    <button type="button" class="calc__copy" data-action="calc-copy">Copy results</button>
  </div>
</section>

<style>
  .calc {
    padding: 32px;
    border-radius: var(--r-section);
    background: var(--panel);
    border: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }

  .calc__inputs {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .calc__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .calc__field input,
  .calc__field select {
    height: 52px;
    padding: 0 14px;
    border-radius: var(--r-input-lg);
    border: 1px solid var(--border-strong);
    background-color: var(--bg);
    color: var(--text);
    font-size: 20px;
    font-variant-numeric: tabular-nums;
  }

  .calc__field select { font-size: 17px; }

  .calc__field input::placeholder { color: var(--text-faint); }

  .calc__field input:hover,
  .calc__field select:hover { border-color: #4A556E; }

  .calc__reset {
    height: 48px;
    margin-top: 4px;
    border-radius: var(--r-input-lg);
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--text);
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
  }

  .calc__reset:hover { border-color: var(--accent-text); color: var(--accent-text); }

  .calc__results {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 24px;
    border-radius: 12px;
    background: var(--bg);
  }

  .calc__primary {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .calc__primary-label {
    font-size: 14px;
    color: var(--text-muted);
  }

  .calc__primary-value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent-text);
    overflow-wrap: anywhere;
  }

  .calc__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }

  .calc__stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .calc__stat-label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .calc__stat-value {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    overflow-wrap: anywhere;
  }

  .calc__copy {
    margin-top: auto;
    height: 44px;
    border-radius: var(--r-btn);
    border: 0;
    background: var(--border);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
  }

  .calc__copy:hover { background: #36405A; }

  @media (max-width: 900px) {
    .calc {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }
    .calc__primary-value { font-size: 44px; }
  }

  @media (max-width: 400px) {
    .calc__stats { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { initCalculators } from '~/scripts/calculators/controller';
  initCalculators();
</script>
