---
import SiteLayout from './SiteLayout.astro';
import RelatedTools from '~/components/sidebar/RelatedTools.astro';
import AdSlot from '~/components/sidebar/AdSlot.astro';
import CtaCard from '~/components/sidebar/CtaCard.astro';
import FaqList, { type Faq } from '~/components/tool/FaqList.astro';
import { relatedTools, toolByHref } from '~/data/tools';
import '~/styles/prose.css';

interface Props {
  href: string;
  title: string;
  description: string;
  heading: string;
  standfirst: string;
  faqs: Faq[];
  related?: string[];
  breadcrumb?: string;
}

const { href, title, description, heading, standfirst, faqs, related, breadcrumb } = Astro.props;

const tool = toolByHref(href);
const sidebarTools = relatedTools(href, related);
const site = 'https://billwright.pages.dev';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tool.name,
    url: `${site}${href}`,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Any',
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Calculators', item: `${site}/calculators` },
      { '@type': 'ListItem', position: 2, name: breadcrumb ?? tool.short, item: `${site}${href}` },
    ],
  },
];
---

<SiteLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="tool shell">
    <div class="tool__main">
      <div class="tool__head">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/calculators">Calculators</a>
          <span aria-hidden="true">/</span>
          <span>{breadcrumb ?? tool.short}</span>
        </nav>
        <h1>{heading}</h1>
        <p class="tool__standfirst">{standfirst}</p>
      </div>

      <slot name="calculator" />

      <article class="prose">
        <slot />
        <FaqList faqs={faqs} />
      </article>
    </div>

    <aside class="tool__aside">
      <RelatedTools tools={sidebarTools} />
      <AdSlot />
      <CtaCard />
    </aside>
  </div>
</SiteLayout>

<style>
  .tool {
    padding-block: 64px 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 64px;
    align-items: start;
  }

  .tool__main {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .tool__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 14px;
    color: var(--text-muted);
  }

  .crumbs a { color: var(--text-muted); }

  h1 {
    font-weight: 700;
    font-size: 56px;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .tool__standfirst {
    font-size: 18px;
    line-height: 1.5;
    color: var(--text-muted);
    max-width: 640px;
  }

  .tool__aside {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 24px;
  }

  @media (max-width: 1100px) {
    .tool { gap: 40px; grid-template-columns: minmax(0, 1fr) 300px; }
    h1 { font-size: 44px; }
  }

  @media (max-width: 900px) {
    .tool {
      grid-template-columns: 1fr;
      padding-block: 40px 0;
      gap: 48px;
    }
    .tool__aside {
      position: static;
      max-width: 520px;
    }
    h1 { font-size: 38px; }
  }

  @media (max-width: 520px) {
    h1 { font-size: 32px; letter-spacing: -0.02em; }
    .tool__standfirst { font-size: 17px; }
  }
</style>
